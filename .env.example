OPENAI_API_KEY=

SECRET_KEY=your_flask_secret_key_here

# Galileo AI Observability Configuration
GALILEO_API_KEY=your-galileo-api-key
GALILEO_CONSOLE_URL=https://console.galileo.ai
GALILEO_PROJECT_NAME=policy_compliance_checker

# OPENAI_API_KEY: Your OpenAI API key (get from https://platform.openai.com/api-keys)
# SECRET_KEY: Flask secret key for session security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# GALILEO_API_KEY: Your Galileo API key (get from https://console.galileo.ai/settings/api-keys)
# GALILEO_CONSOLE_URL: Your Galileo Console URL (typically https://console.galileo.ai)